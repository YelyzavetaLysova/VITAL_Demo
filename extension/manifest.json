{
  "manifest_version": 3,
  "name": "VITAL — MediaFutures",
  "description": "Find claims, inspect evidence and analyse article context.",
  "version": "0.6.0",
  "icons": { "128": "assets/mf-logo.png" },
  "permissions": ["activeTab", "tabs", "storage", "sidePanel", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open VITAL"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["browser-api.js", "content-script.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
