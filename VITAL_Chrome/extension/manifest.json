{
  "manifest_version": 3,
  "name": "VITAL by MediaFutures",
  "version": "1.12.0",
  "description": "Inspect article claims and context.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://vital.demo.mediafutures.no/*"
  ],
  "action": {
    "default_title": "Open VITAL"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "mention-navigation.js",
        "content-script.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "sidepanel.js",
        "config.js",
        "widget-bridge.js",
        "assets/*",
        "widget-overview.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "128": "assets/mf-mainlogo-black.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
